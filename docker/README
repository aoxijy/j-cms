
./docker-compose.yaml

./docker
├── app
│   └── Dockerfile
└── db
    ├── Dockerfile
    └── init.sql

./target
└── j-cms.war

# Build the web application (or copy the .war into ./target)
ant package

# Build/Re-build the Docker images
docker-compose build

# Build/Run all containers in the background
docker-compose up -d

# Connect to the containers
docker ps
docker logs --follow j-cms-app-1
docker exec -it j-cms-app-1 "tail -f /usr/local/tomcat/logs/*"
docker exec -it j-cms-db-1 "psql -U postgres -d j-cms"
